        ],
        "measures": [
          {
            "name": "Total Revenue",
            "description": "Barcha buyurtma qatorlari bo‘yicha sof tushumning jami miqdorini hisoblaydi.",
            "expression": " SUM(FactOrders[NetAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "01 - Sales",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Cost",
            "description": "Barcha buyurtma qatorlari bo‘yicha jami tannarxni hisoblaydi",
            "expression": " SUM(FactOrders[TotalCost])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "01 - Sales",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Gross Profit",
            "description": "Yalpi foydani jami tushumdan jami tannarxni ayirish orqali hisoblaydi",
            "expression": " ([Total Revenue] - [Total Cost])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "01 - Sales",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Margin %",
            "description": "Yalpi foydaning jami tushumga nisbatan foizini hisoblaydi",
            "expression": " DIVIDE([Gross Profit], [Total Revenue], 0)",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Total Quantity",
            "description": "Sotilgan mahsulotlarning jami miqdorini hisoblaydi",
            "expression": " SUM(FactOrders[Quantity])",
            "formatString": "0",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Order Count",
            "description": "Takrorlanmaydigan buyurtma raqamlarini sanab, noyob buyurtmalar sonini hisoblaydi",
            "expression": " DISTINCTCOUNT(FactOrders[OrderNumber])",
            "formatString": "0",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Average Order Value",
            "description": "Jami tushumni noyob buyurtmalar soniga bo‘lish orqali bitta buyurtmaga to‘g‘ri keladigan o‘rtacha tushumni hisoblaydi",
            "expression": [
              "",
              "DIVIDE([Total Revenue], [Order Count], 0)"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "01 - Sales",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Discount",
            "description": "Barcha buyurtma qatorlaridagi chegirmalar summasini hisoblaydi; bo‘sh qiymatlar yig‘indiga kiritilmaydi",
            "expression": " SUM(FactOrders[DiscountAmount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "01 - Sales",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Discount %",
            "description": "Jami chegirma summasining jami tushumga nisbatan foizini hisoblaydi",
            "expression": " DIVIDE([Total Discount], [Total Revenue], 0)",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Return Lines",
            "description": "IsReturn qiymati TRUE bo‘lgan, ya’ni qaytarilgan deb belgilangan buyurtma qatorlarini sanaydi",
            "expression": " CALCULATE(COUNTROWS(FactOrders), FactOrders[IsReturn] = TRUE())",
            "formatString": "0",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Revenue % of Total",
            "description": "Joriy tushumning DimProduct jadvalidagi filtrlar olib tashlangan holatda hisoblangan tushumga nisbatan foizini hisoblaydi",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Revenue],",
              "    CALCULATE(",
              "        [Total Revenue],",
              "        REMOVEFILTERS(DimProduct)",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Revenue % of Category",
            "description": "Joriy filtr kontekstidagi tushumning tegishli mahsulot kategoriyasi bo‘yicha jami tushumga nisbatan foizini ALLEXCEPT yordamida hisoblaydi",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Revenue],",
              "    CALCULATE(",
              "        [Total Revenue],",
              "        ALLEXCEPT(",
              "            DimProduct,",
              "            DimProduct[Category]",
              "        )",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Revenue PY",
            "description": "SAMEPERIODLASTYEAR funksiyasi yordamida joriy davrga mos o‘tgan yil davri tushumini hisoblaydi",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Revenue],",
              "    SAMEPERIODLASTYEAR(DimDate[Date])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "01 - Sales",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "YoY %",
            "description": "Joriy davr tushumining o‘tgan yilning mos davri tushumiga nisbatan foizli o‘zgarishini hisoblaydi",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Revenue] - [Revenue PY],",
              "    [Revenue PY],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "01 - Sales"
          },
          {
            "name": "Revenue YTD",
            "description": "TOTALYTD funksiyasi yordamida yil boshidan joriy sanagacha bo‘lgan jami tushumni hisoblaydi",
            "expression": [
              "",
              "TOTALYTD(",
              "    [Total Revenue],",
              "    DimDate[Date]",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "01 - Sales",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Top Customer Name",
            "description": "Joriy filtr kontekstida eng yuqori tushum keltirgan mijozning nomini qaytaradi",
            "expression": [
              "",
              "VAR CustomerRevenue =",
              "    ADDCOLUMNS(",
              "        VALUES(DimCustomer[CustomerName]),",
              "        \"RevenueValue\", [Total Revenue]",
              "    )",
              "VAR TopCustomer =",
              "    TOPN(",
              "        1,",
              "        CustomerRevenue,",
              "        [RevenueValue], DESC,",
              "        DimCustomer[CustomerName], ASC",
              "    )",
              "RETURN",
              "    CONCATENATEX(",
              "        TopCustomer,",
              "        DimCustomer[CustomerName],",
              "        \", \"",
              "    )"
            ],
            "displayFolder": "01 - Sales"
          }
        ]
      }
    ],
